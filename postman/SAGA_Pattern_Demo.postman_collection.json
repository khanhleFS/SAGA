			"name": "1. BEFORE SAGA (Reproduce Bugs)",
			"item": [
				{
					"name": "BUG-1: Partial Commit (No Compensation)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"CUST-POOR\",\n  \"productId\": \"PROD-002\",\n  \"quantity\": 1,\n  \"amount\": 1000.00\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/orders/without-saga?mode=partial_commit",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "orders", "without-saga"],
							"query": [{ "key": "mode", "value": "partial_commit" }]
						}
					}
				},
				{
					"name": "BUG-2: Dirty Read (Direct /deduct without Semantic Lock)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"CUST-POOR\",\n  \"productId\": \"PROD-002\",\n  \"quantity\": 1,\n  \"amount\": 1000.00\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/orders/without-saga?mode=no_semantic_lock",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "orders", "without-saga"],
							"query": [{ "key": "mode", "value": "no_semantic_lock" }]
						}
					}
				},
				{
					"name": "BUG-3: Duplicate Request (No Operation Log -> x2 Debit)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"CUST-RICH\",\n  \"productId\": \"PROD-001\",\n  \"quantity\": 1,\n  \"amount\": 2000.00\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/orders/without-saga?mode=duplicate_request",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "orders", "without-saga"],
							"query": [{ "key": "mode", "value": "duplicate_request" }]
						}
					}
				}
			]
		},
		{
			"name": "2. AFTER SAGA (5 Golden Rules)",
			"item": [
				{
					"name": "Happy Path (Order -> Inventory -> Payment -> Confirm)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"CUST-RICH\",\n  \"productId\": \"PROD-001\",\n  \"quantity\": 1,\n  \"amount\": 2000.00\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/orders",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "orders"]
						}
					}
				},
				{
					"name": "Rule 1: LIFO Compensation (Insufficient Funds)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"CUST-POOR\",\n  \"productId\": \"PROD-002\",\n  \"quantity\": 1,\n  \"amount\": 1000.00\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/orders",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "orders"]
						}
					}
				},
				{
					"name": "Rule 3: Idempotency Check (Duplicate Calls -> 1x Debit)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"CUST-RICH\",\n  \"productId\": \"PROD-001\",\n  \"quantity\": 1,\n  \"amount\": 2000.00\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/orders/duplicate-check",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "orders", "duplicate-check"]
						}
					}
				},
				{
					"name": "Rule 4: Fail-Fast (Out of Stock -> Never Calls Payment)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"CUST-RICH\",\n  \"productId\": \"PROD-OUT-OF-STOCK\",\n  \"quantity\": 1,\n  \"amount\": 600.00\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/orders",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "orders"]
						}
					}
				}
			]
		},
